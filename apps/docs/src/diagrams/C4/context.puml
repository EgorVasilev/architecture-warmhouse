Rel(SmartHomeEcosystem,payments,"Processes payments")
Rel(SmartHomeEcosystem,sensors,"Polls environment data: temperature, humidity, etc")
Rel(SmartHomeEcosystem,devices,"Sends control commands")

@enduml
